# From your GitHub App's settings page (https://github.com/settings/apps)
GITHUB_APP_ID=

# The full contents of the .pem file you download when you generate a private key.
# Paste it with literal \n for line breaks if you keep it on one line, e.g.:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_PRIVATE_KEY=

# Set this to any random string, then enter the SAME string as the "Webhook secret"
# in your GitHub App settings.
GITHUB_WEBHOOK_SECRET=

PORT=3000
